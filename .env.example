# Copy to .env for local development; set the same values in Vercel → Settings → Environment Variables.
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-webhook-id
# Shared secret sent as the X-Webhook-Secret header; must match n8n's Header Auth credential.
N8N_WEBHOOK_SECRET=
# Supabase project used to verify logged-in users. Use the publishable key, never the secret/service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
